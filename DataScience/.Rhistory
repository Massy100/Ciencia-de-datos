nasa = "https://www.nasa.gov/2026-news-releases/"
pagina <- read_html(nasa)
titulos <- pagina %>%
html_nodes(".hds-a11y-heading-22") %>%
html_text(trim = TRUE) #trim = TRUE elimina espacios innecesarios
print(titulos)
