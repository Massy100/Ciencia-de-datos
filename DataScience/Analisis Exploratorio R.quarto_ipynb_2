        "#| label: comparacion-imputacion-python\n",
        "#| echo: true\n",
        "\n",
        "# Función para calcular estadísticos comparativos\n",
        "def comparar_imputaciones(original, imputado, variable):\n",
        "    return pd.DataFrame({\n",
        "        'Métrica': ['Media', 'Mediana', 'Desv_Estandar'],\n",
        "        'Original': [\n",
        "            original[variable].mean(),\n",
        "            original[variable].median(),\n",
        "            original[variable].std()\n",
        "        ],\n",
        "        'Imputado': [\n",
        "            imputado[variable].mean(),\n",
        "            imputado[variable].median(),\n",
        "            imputado[variable].std()\n",
        "        ]\n",
        "    })\n",
        "\n",
        "# Comparar métodos para edad\n",
        "print(\"Comparación de métodos de imputación para Edad:\")\n",
