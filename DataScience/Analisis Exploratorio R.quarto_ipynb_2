        "# Crear dataset de ejemplo con valores faltantes y atípicos con python\n",
        "np.random.seed(123)\n",
        "n = 1000\n",
        "\n",
        "datos_python = pd.DataFrame({\n",
        "  'id': range(1,n+1),\n",
        "  'edad': np.round(np.random.normal(35,12,n)).astype(int),\n",
        "  'ingreso': np.round(np.random.normal(50000, 15000, n)).astype(int),\n",
        "  'educacion': np.random.choice([1,2,3,4,5], n, p=[0.1, 0.2, 0.3, 0.25, 0.15]), \n",
        "  'experiencia': np.round(np.random.normal(10,7,n)).astype(int),\n",
        "  'satisfaccion': np.round(np.random.uniform(1,10,n))\n",
        "})\n",
        "\n",
        "# Introducir valores faltantes (MCAR)\n",
        "indices_na = np.random.choice(range(n), size=50, replace=False)\n",
        "datos_python.loc[indices_na, 'edad'] = np.nan\n",
        "\n",
        "# Introducir valores atípicos\n",
        "indices_outliers = np.random.choice(range(n), size=20, replace=False)\n",
        "datos_python.loc[indices_outliers, 'ingreso'] = datos_python.loc[indices_outliers, 'ingreso'] * 5\n",
        "\n",
        "# Introducir valores faltantes condicionales (MAR)\n",
        "indices_mar = np.random.choice(datos_python[datos_python['educacion'] >= 4].index, size=30, replace=False)\n",
        "datos_python.loc[indices_mar, 'satisfaccion'] = np.nan\n",
        "\n",
        "# Ver resultados\n",
        "print(datos_python.head())"
